# =============================================================================
# Environment variables for PRODUCTION. Copy to `.env.prod` and fill in the values:
#   cp .env.prod.example .env.prod
# `.env.prod` is git-ignored: it is NOT committed.
# =============================================================================

# Django secret key. Generate a NEW one (do not reuse the development key):
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-long-random-key

# Always False in production.
DEBUG=False

# Domains serving the app (comma separated, no scheme).
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Trusted origins for CSRF (WITH scheme, usually https).
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# PostgreSQL. DB_HOST=db is the Postgres service name in compose.prod.yaml.
DB_NAME=eportfolio
DB_USER=eportfolio
DB_PASSWORD=replace-with-a-strong-password
DB_HOST=db
DB_PORT=5432

SITE_URL=https://yourdomain.com

# HTTPS hardening. Keep these commented until TLS is in front of the app;
# enabling them without real HTTPS causes a redirect loop.
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000

DJANGO_LOG_LEVEL=INFO
