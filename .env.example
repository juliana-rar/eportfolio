# =============================================================================
# Environment variables for DEVELOPMENT. Copy to `.env` and fill in the values:
#   cp .env.example .env
# `.env` is git-ignored: it is NOT committed.
# For production see `.env.prod.example`.
# =============================================================================

# Django secret key. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-long-random-key

DEBUG=True

# Hosts serving the app (comma separated, no scheme).
ALLOWED_HOSTS=localhost,127.0.0.1

# Trusted origins for CSRF (WITH scheme).
CSRF_TRUSTED_ORIGINS=http://localhost:8095,http://127.0.0.1:8095

# PostgreSQL. Inside compose DB_HOST is forced to "db".
DB_NAME=eportfolio
DB_USER=eportfolio
DB_PASSWORD=replace-with-a-password
DB_HOST=db
DB_PORT=5432

# Absolute base URL used in sitemap/Open Graph when there is no request (optional).
SITE_URL=http://localhost:8095

DJANGO_LOG_LEVEL=INFO
